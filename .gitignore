# ==============================================================================
# .gitignore — SWP391 Sport Center (Fullstack .NET 10 + React 19 Vite)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------------------------------------------
# 2. Microsoft Office Temporary & Lock Files (Word / Excel / PowerPoint)
# ------------------------------------------------------------------------------
~$*
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.bak
*.swp

# ------------------------------------------------------------------------------
# 3. IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.opendb
*.pdb

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (Rider, WebStorm, IntelliJ)
.idea/
*.iws

# ------------------------------------------------------------------------------
# 4. Backend (.NET 10 / ASP.NET Core / C#)
# ------------------------------------------------------------------------------
# Build outputs
[Bb]in/
[Oo]bj/
[Oo]ut/
backend/**/bin/
backend/**/obj/
backend/**/out/

# Local configuration files & Secrets (Do not commit to public repositories)
backend/**/appsettings.Development.json
backend/**/appsettings.Local.json
backend/**/secrets.json
**/*.pfx
**/*.p12
**/*.key
**/*.cer
**/*.pem
**/*.cert

# Local uploaded media directory fallback (when not using Cloudinary CDN)
**/wwwroot/uploads/**
!**/wwwroot/uploads/
!**/wwwroot/uploads/**/.gitkeep

# Logs & Test Results
*.log
backend/**/*.log
logs/
**/logs/
[Tt]est[Rr]esult*/
coverage*/
*.trx
*.coverage

# ------------------------------------------------------------------------------
# 5. Frontend (React 19 / Vite / TypeScript / Tailwind CSS)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
out/
Frontend/dist/
Frontend/dist-ssr/
Frontend/build/

# Vite & tool caching
.vite/
Frontend/.vite/
.eslintcache
.stylelintcache
Frontend/.eslintcache
Frontend/.stylelintcache
.cache/
Frontend/.cache/
*.tsbuildinfo

# Frontend Environment variables (contain API keys and private tokens)
.env
.env.local
.env.*.local
Frontend/.env
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.test.local
Frontend/.env.production.local
Frontend/.env.*.local
!.env.example
!Frontend/.env.example

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
Frontend/npm-debug.log*
Frontend/yarn-debug.log*
Frontend/yarn-error.log*
Frontend/pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. AI Assistants, CLI Tools & .NET Global Caches
# ------------------------------------------------------------------------------
.gemini/
**/.gemini/
.agents/
**/.agents/
.cursor/
.windsurf/
.claude/
.copilot/
.dotnet/
**/.dotnet/
.dotnet*
.dotnet*/
.dotnet_temp/
*.dotnetUserLevelCache
*.toolpath.sentinel

# ------------------------------------------------------------------------------
# 7. Scratch Scripts & Temporary Testing Artifacts
# ------------------------------------------------------------------------------
scratch/
**/scratch/
*CheckDbTables*
CheckDbTablesTest.cs

# Planning documents (keep shared implementation plan)
docs/Flow_5*.md
docs/Flow_6*.md
!docs/Flow_5_6_AI_Implementation_Plan.md

# ------------------------------------------------------------------------------
# 8. Test Data Dumps, Sensitive Logs & Tunneling
# ------------------------------------------------------------------------------
cracked_accounts.json
users_dump.json
users_summary.txt
test_github.txt
*.dump
*.dmp
*.sql.bak
dump/
dumps/
ngrok.log
.ngrok*

# ------------------------------------------------------------------------------
# 9. Python Cache (if running auxiliary scripts)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
