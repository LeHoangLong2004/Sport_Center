backend/**/appsettings.Local.json
backend/**/secrets.json

# Environment variables containing private tokens & credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
Frontend/.env
Frontend/.env.*
Frontend/.env.local
backend/.env
backend/.env.*
!.env.example
!Frontend/.env.example
!backend/.env.example

# User secrets, private keys & certificates
secrets.json
**/secrets.json
**/secrets/
**/*.pfx
**/*.p12
**/*.key
**/*.cer
**/*.pem
**/*.cert
**/*.crt
*.id_rsa
*.id_ed25519

