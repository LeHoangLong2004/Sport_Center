# Cấu hình Git Attributes để đồng bộ hóa xuống dòng (chống lỗi conflict do HĐH Windows và Mac/Linux khác nhau)

# Đặt mặc định LF cho các file text
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.cs text diff=csharp
*.sln text eol=crlf
*.csproj text eol=crlf
*.json text
*.md text
*.html text
*.css text
*.js text
*.ts text
*.jsx text
*.tsx text
*.sql text

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
