@startuml
!theme plain
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam roundcorner 5
skinparam shadowing false

package "1. Authentication & System" {
  entity Roles {
    * id : INT <<PK>>
    --
    * name : VARCHAR <<UK>>
    description : VARCHAR
  }

  entity Users {
    * id : INT <<PK>>
    --
    role_id : INT <<FK>>
    full_name : VARCHAR
    phone_number : VARCHAR <<UK>>
    email : VARCHAR <<UK>>
    password_hash : VARCHAR
    avatar_url : VARCHAR
    date_of_birth : DATE
    gender : VARCHAR
    emergency_contact : VARCHAR
    status : BOOLEAN
    created_at : TIMESTAMPTZ
  }

  entity Notifications {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    title : VARCHAR
    message : TEXT
    is_read : BOOLEAN
    created_at : TIMESTAMPTZ
  }

  entity Contact_Messages {
    * id : INT <<PK>>
    --
    sender_name : VARCHAR
    sender_email : VARCHAR
    sender_phone : VARCHAR
    message : TEXT
    is_resolved : BOOLEAN
    created_at : TIMESTAMPTZ
  }

  entity Audit_Logs {
    * id : INT <<PK>>
    --
    actor_id : INT <<FK>>
    action : VARCHAR
    entity_type : VARCHAR
    entity_id : INT
    old_value : TEXT
    new_value : TEXT
    ip_address : VARCHAR
    created_at : TIMESTAMPTZ
  }
}

package "2. Facility & Membership" {
  entity Facilities {
    * id : INT <<PK>>
    --
    name : VARCHAR
    address : VARCHAR
    hotline : VARCHAR
    status : BOOLEAN
  }

  entity CheckIn_Logs {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    facility_id : INT <<FK>>
    check_in_time : TIMESTAMPTZ
    status : VARCHAR
  }

  entity Packages {
    * id : VARCHAR <<PK>>
    --
    name : VARCHAR
    tagline : VARCHAR
    monthly_price : DECIMAL
    yearly_price : DECIMAL
    status : BOOLEAN
  }

  entity Package_Features {
    * id : INT <<PK>>
    --
    package_id : VARCHAR <<FK>>
    feature_text : VARCHAR
  }

  entity Vouchers {
    * id : INT <<PK>>
    --
    code : VARCHAR <<UK>>
    discount_percent : DECIMAL
    max_discount : DECIMAL
    valid_from : TIMESTAMPTZ
    valid_to : TIMESTAMPTZ
    usage_limit : INT
    used_count : INT
    status : BOOLEAN
  }

  entity Subscriptions {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    package_id : VARCHAR <<FK>>
    facility_id : INT <<FK>>
    voucher_id : INT <<FK>>
    billing_period : VARCHAR
    total_amount : DECIMAL
    payment_method : VARCHAR
    payment_status : VARCHAR
    start_date : DATE
    end_date : DATE
    created_at : TIMESTAMPTZ
  }
}

package "3. Coaches, Classes & Training" {
  entity Coaches {
    * id : INT <<PK>>
    --
    user_id : INT <<FK, UK>>
    specialty : VARCHAR
    bio : TEXT
    experience_years : INT
    rating : DECIMAL
  }

  entity Sports {
    * id : INT <<PK>>
    --
    name : VARCHAR
    description : TEXT
    image_url : VARCHAR
    status : BOOLEAN
  }

  entity Classes {
    * id : INT <<PK>>
    --
    sport_id : INT <<FK>>
    coach_id : INT <<FK>>
    facility_id : INT <<FK>>
    class_name : VARCHAR
    schedule_time : TIMESTAMPTZ
    duration_minutes : INT
    capacity : INT
    current_enrolled : INT
    status : BOOLEAN
  }

  entity Class_Bookings {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    class_id : INT <<FK>>
    status : VARCHAR
    created_at : TIMESTAMPTZ
  }

  entity Class_Attendance {
    * id : INT <<PK>>
    --
    class_id : INT <<FK>>
    booking_id : INT <<FK>>
    user_id : INT <<FK>>
    attendance_status : VARCHAR
    note : VARCHAR
    marked_by : INT <<FK>>
    marked_at : TIMESTAMPTZ
  }

  entity PT_Sessions {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    coach_id : INT <<FK>>
    schedule_time : TIMESTAMPTZ
    duration_minutes : INT
    status : VARCHAR
    notes : TEXT
  }

  entity Reviews {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    coach_id : INT <<FK>>
    rating : INT
    comment : TEXT
    created_at : TIMESTAMPTZ
  }

  entity Body_Metrics {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    weight : DECIMAL
    height : DECIMAL
    body_fat : DECIMAL
    muscle_mass : DECIMAL
    bmi : DECIMAL
    recorded_at : TIMESTAMPTZ
  }

  entity Workout_Plans {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    coach_id : INT <<FK>>
    plan_name : VARCHAR
    description : TEXT
    start_date : DATE
    end_date : DATE
  }

  entity Diet_Plans {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    coach_id : INT <<FK>>
    calories_target : INT
    meals_description : TEXT
    created_at : TIMESTAMPTZ
  }

  entity Training_Records {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    coach_id : INT <<FK>>
    workout_plan_id : INT <<FK>>
    record_type : VARCHAR
    title : VARCHAR
    goal : VARCHAR
    score : DECIMAL
    duration_minutes : INT
    calories_burned : INT
    details : JSONB
    ai_prompt : TEXT
    ai_recommendation : TEXT
    disclaimer : VARCHAR
    recorded_at : TIMESTAMPTZ
  }
}

package "4. Finance, Products & Blog" {
  entity Products {
    * id : INT <<PK>>
    --
    name : VARCHAR
    category : VARCHAR
    price : DECIMAL
    stock_quantity : INT
    image_url : VARCHAR
    status : BOOLEAN
  }

  entity Invoices {
    * id : INT <<PK>>
    --
    user_id : INT <<FK>>
    created_by : INT <<FK>>
    total_amount : DECIMAL
    payment_method : VARCHAR
    created_at : TIMESTAMPTZ
  }

  entity Invoice_Items {
    * id : INT <<PK>>
    --
    invoice_id : INT <<FK>>
    product_id : INT <<FK>>
    quantity : INT
    unit_price : DECIMAL
  }

  entity Budgets {
    * id : INT <<PK>>
    --
    facility_id : INT <<FK>>
    category : VARCHAR
    period_start : DATE
    period_end : DATE
    allocated_amount : DECIMAL
    spent_amount : DECIMAL
    status : VARCHAR
    created_by : INT <<FK>>
    created_at : TIMESTAMPTZ
  }

  entity Expenses {
    * id : INT <<PK>>
    --
    facility_id : INT <<FK>>
    category : VARCHAR
    description : VARCHAR
    amount : DECIMAL
    expense_date : DATE
    status : VARCHAR
    created_by : INT <<FK>>
    approved_by : INT <<FK>>
    created_at : TIMESTAMPTZ
  }

  entity Payroll_Records {
    * id : INT <<PK>>
    --
    employee_id : INT <<FK>>
    facility_id : INT <<FK>>
    payroll_month : DATE
    base_salary : DECIMAL
    bonus : DECIMAL
    deduction : DECIMAL
    net_salary : DECIMAL
    status : VARCHAR
    paid_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
  }

  entity Article_Categories {
    * id : INT <<PK>>
    --
    name : VARCHAR
    description : VARCHAR
  }

  entity Articles {
    * id : INT <<PK>>
    --
    category_id : INT <<FK>>
    author_id : INT <<FK>>
    title : VARCHAR
    thumbnail_url : VARCHAR
    content : TEXT
    status : VARCHAR
    published_at : TIMESTAMPTZ
  }
}

' ================= Relationships =================
Roles ||--o{ Users
Users ||--o{ Notifications
Users ||--o| Coaches
Users ||--o{ Body_Metrics
Users ||--o{ Audit_Logs

Facilities ||--o{ CheckIn_Logs
Users ||--o{ CheckIn_Logs

Packages ||--o{ Package_Features
Packages ||--o{ Subscriptions
Users ||--o{ Subscriptions
Facilities ||--o{ Subscriptions
Vouchers ||--o{ Subscriptions

Sports ||--o{ Classes
Coaches ||--o{ Classes
Facilities ||--o{ Classes
Classes ||--o{ Class_Bookings
Users ||--o{ Class_Bookings
Classes ||--o{ Class_Attendance
Class_Bookings ||--o| Class_Attendance
Users ||--o{ Class_Attendance

Users ||--o{ PT_Sessions
Coaches ||--o{ PT_Sessions
Users ||--o{ Reviews
Coaches ||--o{ Reviews
Workout_Plans ||--o{ Training_Records
Users ||--o{ Workout_Plans
Coaches ||--o{ Workout_Plans
Users ||--o{ Diet_Plans
Coaches ||--o{ Diet_Plans
Users ||--o{ Training_Records
Coaches ||--o{ Training_Records

Users ||--o{ Invoices
Invoices ||--o{ Invoice_Items
Products ||--o{ Invoice_Items

Facilities ||--o{ Budgets
Facilities ||--o{ Expenses
Facilities ||--o{ Payroll_Records
Users ||--o{ Payroll_Records
Users ||--o{ Budgets
Users ||--o{ Expenses

Article_Categories ||--o{ Articles
Users ||--o{ Articles
@enduml