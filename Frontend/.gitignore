# ==============================================================================
# .gitignore — Frontend (React 19 + Vite + TypeScript + Tailwind CSS)
# ==============================================================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# 2. Production build outputs
dist/
dist-ssr/
build/
out/

# 3. Cache & temporary tooling directories
.vite/
.eslintcache
.stylelintcache
.cache/
*.tsbuildinfo

# 4. Environment files (chứa token, API keys bí mật)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 5. Package manager & Server logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Microsoft Office temporary & lock files
~$*
~$*.docx
~$*.xlsx
~$*.pptx

# 7. Code Editors & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.swp
*.bak
*.tmp
*~

# 8. Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 9. AI Assistants & Tooling caches
.gemini/
**/.gemini/
.agents/
**/.agents/
.cursor/
.windsurf/
.claude/
.copilot/
