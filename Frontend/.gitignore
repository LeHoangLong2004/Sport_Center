# ==============================================================================
# .gitignore — Frontend (React + Vite + TypeScript + Tailwind)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
out/

# Cache & temporary directories
.vite/
.eslintcache
.stylelintcache
.cache/

# Environment files (Chứa secret API keys không đưa lên Git)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.user
*.swp
*~

# AI Assistant & Tooling
.gemini/
.agents/
