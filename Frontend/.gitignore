# ==============================================================================
# .gitignore — Frontend (React 19 + Vite + TypeScript + Tailwind CSS)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
out/

# Cache & temporary build directories
.vite/
.eslintcache
.stylelintcache
.cache/
*.tsbuildinfo

# Environment files (sensitive tokens & local variables)
.env
.env.*
!.env.example

# Package manager & server logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Microsoft Office temporary lock files
~$*
~$*.docx
~$*.xlsx

# Editor & OS files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.user
*.swp
*.bak
*.tmp
*~
