Table Audit_Logs [headercolor: #64748B] {
  id int [pk, increment]
  actor_id int
  action varchar(100) [not null]
  entity_type varchar(100)
  entity_id int
  old_value text
  new_value text
  ip_address varchar(45)
  created_at timestamptz
}

Table Budgets [headercolor: #64748B] {
  id int [pk, increment]
  facility_id int [not null]
  category varchar(100) [not null]
  period_start date [not null]
  period_end date [not null]
  allocated_amount decimal(18,2) [not null]
  spent_amount decimal(18,2) [not null]
  status varchar(50)
  created_by int
  created_at timestamptz
}

Table Expenses [headercolor: #64748B] {
  id int [pk, increment]
  facility_id int [not null]
  category varchar(100) [not null]
  description varchar(500) [not null]
  amount decimal(18,2) [not null]
  expense_date date [not null]
  status varchar(50)
  created_by int
  approved_by int
  created_at timestamptz
}

Table Payroll_Records [headercolor: #64748B] {
  id int [pk, increment]
  employee_id int [not null]
  facility_id int
  payroll_month date [not null]
  base_salary decimal(18,2) [not null]
  bonus decimal(18,2) [not null]
  deduction decimal(18,2) [not null]
  net_salary decimal(18,2) [not null]
  status varchar(50)
  paid_at timestamptz
  created_at timestamptz
  indexes { (employee_id, payroll_month) [unique] }
}

Table Class_Attendance [headercolor: #14B8A6] {
  id int [pk, increment]
