## ============================================================
##  .gitignore — SmartGym Backend (.NET 10 / ASP.NET Core)
## ============================================================

# -------------------------------------------------------
# 1. Build outputs & Compilations
# -------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/
[Ll]og/
[Ll]ogs/
*.log

# -------------------------------------------------------
# 2. Visual Studio & Code Editors
# -------------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.VC.VC.opendb

# VS Code (giữ lại cấu hình dùng chung)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -------------------------------------------------------
# 3. .NET CLI, MSBuild & NuGet
# -------------------------------------------------------
project.lock.json
project.fragment.lock.json
**/Properties/launchSettings.json
*.nupkg
*.snupkg
.nuget/
packages/
nuget.config
!**/[Pp]ackages/build/

# -------------------------------------------------------
# 4. Publish profiles & Deployment
# -------------------------------------------------------
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
docker-compose.override.yml

# -------------------------------------------------------
# 5. Static Assets & Uploads
# -------------------------------------------------------
wwwroot/dist/
wwwroot/uploads/**
!wwwroot/uploads/
!wwwroot/uploads/**/.gitkeep

# -------------------------------------------------------
# 6. Local Environment & Secrets (Không push thông tin mật)
# -------------------------------------------------------
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
appsettings.Staging.json
appsettings.Production.json
secrets.json
**/secrets/
**/*.pfx
**/*.p12
**/*.key
**/*.cer
**/*.crt
**/*.pem

# -------------------------------------------------------
# 7. Test Results & Coverage
# -------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
coverage*.xml
coverage*.json
*.trx
*.coverage
*.coveragexml
_ReSharper*/

# -------------------------------------------------------
# 8. Temporary Files & Office Lock Files
# -------------------------------------------------------
~$*
~$*.docx
~$*.xlsx
*.swp
*.bak
*.tmp
*~

# -------------------------------------------------------
# 9. Operating System Files
# -------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# -------------------------------------------------------
# 10. AI Agents & .NET Tooling Caches
# -------------------------------------------------------
.gemini/
**/.gemini/
.agents/
**/.agents/
.cursor/
.windsurf/
.copilot/
.dotnet/
**/.dotnet/
*.dotnetUserLevelCache
*.toolpath.sentinel
